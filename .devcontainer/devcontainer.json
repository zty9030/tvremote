{
    "name": "tvremote",
    "build": {
        "dockerfile": "../docker/Dockerfile"
    },
    "workspaceFolder": "/workspace",
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspace,type=bind"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.Go"
            ]
        }
    },
    "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
        "version": "latest"
    }
}
}